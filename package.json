{
  "name": "circuit-json-to-sysconfig",
  "version": "0.0.1",
  "description": "Foundation for converting Circuit JSON to TI SysConfig",
  "type": "module",
  "module": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": "./lib/index.ts",
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/circuit-json-to-sysconfig.git"
  },
  "scripts": {
